# ==============================================================================
# Google Play Vitals MCP - Environment Variables Configuration
# ==============================================================================

# 1. Google Cloud Service Account JSON Key Path
# Path to your downloaded GCP service account JSON key file with Play Developer Reporting API access.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service_account.json

# 2. Or pass credentials directly as a JSON string (useful for CI/CD or Cloud deployments)
# GOOGLE_PLAY_CREDENTIALS_JSON='{"type": "service_account", "project_id": "..."}'

# 3. Default Android Package Name
# Set your app's default application ID (e.g. com.example.android.app)
# GOOGLE_PLAY_PACKAGE_NAME=com.example.android.app

# 4. Cache TTL in seconds (default: 300 = 5 minutes)
# GOOGLE_PLAY_CACHE_TTL=300
